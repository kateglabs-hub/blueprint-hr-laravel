APP_NAME="BluePrint HR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blueprint_hr
DB_USERNAME=blueprint_hr
DB_PASSWORD=blueprint_hr_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=sqs
FILESYSTEM_DISK=s3
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://floci:4566
AWS_URL=http://floci:4566
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=blueprint-hr-local
SQS_PREFIX=http://floci:4566/000000000000
SQS_QUEUE=blueprint-hr-local

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
BLUEPRINT_ADMIN_EMAIL=admin@blueprint.test
BLUEPRINT_ADMIN_PASSWORD=
BLUEPRINT_DEMO_PASSWORD=local-demo-password
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
